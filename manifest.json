{
  "manifest_version": 3,
  "name": "QuickSwitcher",
  "version": "1.4.0",
  "description": "Keyboard-only Alt+Q recent tab switcher with live page thumbnails.",
  "action": {
    "default_title": "QuickSwitcher",
    "default_popup": "pages/popup.html",
    "default_icon": "assets/icon-park--exchange-four.png"
  },
  "icons": {
    "48": "assets/icon-park--exchange-four.png"
  },
  "background": {
    "service_worker": "background/main.js"
  },
  "content_scripts": [
    {
      "matches": [ "<all_urls>" ],
      "js": [ "content/key-observer.js" ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "commands": {
    "show-tab-switcher": {
      "description": "Show the recent tab switcher",
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      }
    }
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [ "assets/placeholder.svg", "_favicon/*" ],
      "matches": [ "<all_urls>" ]
    }
  ]
}
